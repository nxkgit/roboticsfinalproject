<!-- Real robot: shape_drawer + path_recorder only (bringup already runs on the robot).
     Run from a normal terminal (NOT sim_env.sh) after the README checklist:
       roslaunch beginner_tutorials draw_shape.launch shape:=square dry_run:=true
     The drawer asks you to type YES before moving (master is not localhost). -->
<launch>
  <arg name="shape"       default="square"/>
  <arg name="area_w"      default="1.5"/>
  <arg name="area_h"      default="1.5"/>
  <arg name="margin"      default="0.15"/>
  <arg name="footprint_r" default="0.15"/>
  <arg name="size"        default="0.0"/>
  <arg name="speed"       default="0.1"/>   <!-- slower default for the real robot -->
  <arg name="dry_run"     default="false"/>
  <arg name="rviz"        default="false"/>
  <arg name="odom_topic"  default="/odom"/>  <!-- VERIFY on the robot: see README checklist step 2 -->

  <node pkg="beginner_tutorials" type="shape_drawer.py" name="shape_drawer" output="screen" required="true">
    <param name="shape"       value="$(arg shape)"/>
    <param name="area_w"      value="$(arg area_w)"/>
    <param name="area_h"      value="$(arg area_h)"/>
    <param name="margin"      value="$(arg margin)"/>
    <param name="footprint_r" value="$(arg footprint_r)"/>
    <param name="size"        value="$(arg size)"/>
    <param name="speed"       value="$(arg speed)"/>
    <param name="dry_run"     value="$(arg dry_run)"/>
    <param name="odom_topic"  value="$(arg odom_topic)"/>
    <param name="require_confirm" value="true"/>
  </node>

  <node pkg="beginner_tutorials" type="path_recorder.py" name="path_recorder" output="screen">
    <param name="odom_topic" value="$(arg odom_topic)"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find beginner_tutorials)/rviz/shapes.rviz"/>
</launch>
